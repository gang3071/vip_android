<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:color="@color/color_323563"
    tools:ignore="NewApi">
    <item android:id="@android:id/mask"
        tools:ignore="NewApi">
        <shape>
            <solid android:color="@color/color_323563" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <!-- 默认显⽰效果-->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="@color/color_323563"
                android:endColor="@color/color_323563"
                android:type="linear"
                android:useLevel="true" />
            <stroke android:width="1dp" android:color="#333333"/>
            <corners
                android:radius="30dp" />
        </shape>
    </item>
</ripple>

